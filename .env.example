# JFrog CI tool configuration. Copy to .env and fill in what you use; every value is optional.
# The CI collectors (python -m ci.run) and the labeling page need no keys. Commented lines show the default.
# tests/test_env_example.py keeps this file in step with the variables the code reads.

# --- Gemini: writes and ranks (PRD D5). API key by default; Vertex AI is opt-in.
# Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Model name, used on both the API-key and the Vertex route
# GEMINI_MODEL=gemini-3.6-flash
# Set to true to call Gemini through Vertex AI instead of the API key
# GOOGLE_GENAI_USE_VERTEXAI=false
# Vertex AI project id (needed only with GOOGLE_GENAI_USE_VERTEXAI=true)
# GOOGLE_CLOUD_PROJECT=my-gcp-project
# Vertex AI region
# GOOGLE_CLOUD_LOCATION=us-central1
# Service-account key file for Vertex AI (read by google-auth)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Claude: the judge (PRD D5, D17)
# Anthropic API key (read by the anthropic SDK); only the judge and the golden-set eval need it
ANTHROPIC_API_KEY=
# Judge model for the per-run trace judge
# JUDGE_MODEL_DAILY=claude-haiku-4-5
# Judge model for the golden-set evals
# JUDGE_MODEL_EVAL=claude-sonnet-5-5

# --- LangSmith tracing (optional)
# Set to true to send traces (read by the langsmith SDK)
LANGSMITH_TRACING=false
# LangSmith API key
LANGSMITH_API_KEY=
# LangSmith project the traces and the dashboard use
# LANGSMITH_PROJECT=default
# CI pipeline only (D48, D51): tracing is off unless this is true, only for the daily run, never in an eval
# CI_LANGSMITH_TRACING=false

# --- Old funnel (python main.py) until the competitors config drives it
# Topic the shortlist and ranker prompts screen for
# SUBJECT=JFrog's competitors and the software supply chain: artifact management, package registries, DevSecOps and CI/CD
# Reader the ranker writes for
# AUDIENCE=a competitive-intelligence analyst at JFrog
# Reader's experience level
# EXPERIENCE=expert
# How many ranked items a run keeps
# TOP_K=10
# Hacker News search queries, comma-separated
# HN_QUERIES=Sonatype,Snyk,Cloudsmith,GitLab,GitHub Advanced Security,CodeArtifact,software supply chain
# healthchecks.io ping URL, pinged after each run (empty: no ping)
HEALTHCHECK_PING_URL=

# --- Jessi API (python -m ci.api)
# Demo mode: serve this read-only snapshot (python -m ci.demo build --out data/demo) instead of the live store
# CI_DEMO_DIR=data/demo
# Listen address; 127.0.0.1 unless set. Only the container sets it (0.0.0.0, port published on the host's loopback)
# CI_API_HOST=127.0.0.1
