# Keep the build context small and free of secrets and local state.
.git
.gitignore
.claude
.venv
venv
env
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.vscode
.idea

# secrets and credentials
.env
.env.*
!.env.example
config/token.json
config/credentials.json
config/service_account.json
*.pem
*.key

# runtime state and labels come from host bind mounts (docker-compose.yml)
data
output
evals/golden_set.jsonl
evals/ranking_golden.json
evals/split_assignments.json

# the web UI has its own image (docker/ui.Dockerfile); its build output never goes into the API image
frontend/node_modules
frontend/.next
frontend/.next-build

# docs and images are not needed in the image
docs
README.md
Dockerfile
docker-compose*.yml
.dockerignore
